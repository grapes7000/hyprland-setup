#!/bin/bash
# Power menu for logout, shutdown, reboot, lock

options="󰤄 Lock\n󰍐 Logout\n 󰑙 Reboot\n⏹ Shutdown"

selected=$(echo -e "$options" | ~/.local/bin/wofi-singleton --dmenu -p "Power:" 2>/dev/null)

case "$selected" in
    "󰤄 Lock")
        hyprlock
        ;;
    "󰍐 Logout")
        hyprctl dispatch exit 0
        ;;
    " 󰑙 Reboot")
        systemctl reboot
        ;;
    "⏹ Shutdown")
        systemctl poweroff
        ;;
esac
