#!/usr/bin/env python3
"""Generate and manage Lakota's reversible Hyprland theme adapter."""
from __future__ import annotations

import argparse
import datetime
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CONTRACT = CONFIG / "theme-engine/generated/theme.json"
GENERATED = CONFIG / "hypr/generated/lakota-theme.lua"
ACTIVE_LUA = CONFIG / "caelestia/hypr-user.lua"
BEGIN = "-- BEGIN LAKOTA HYPR THEME (managed)"
END = "-- END LAKOTA HYPR THEME (managed)"
BLOCK = f'{BEGIN}\ndofile(os.getenv("HOME") .. "/.config/hypr/generated/lakota-theme.lua")\n{END}'


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def installed_version() -> tuple[int, int, int]:
    proc = subprocess.run(["Hyprland", "--version"], text=True, capture_output=True, check=False)
    match = re.search(r"Hyprland (\d+)\.(\d+)\.(\d+)", proc.stdout + proc.stderr)
    if not match:
        raise RuntimeError("unable to detect installed Hyprland version")
    return tuple(map(int, match.groups()))


def lua_string(value: str) -> str:
    return json.dumps(value)


def boolean(value: object, default: bool = False) -> bool:
    if value is None:
        return default
    return value is True or str(value).lower() in {"1", "true", "yes", "on"}


def render(theme: dict, version: tuple[int, int, int]) -> str:
    if version < (0, 40, 0):
        raise RuntimeError(f"Hyprland {version!r} is unsupported; 0.40+ is required")
    roles, style = theme.get("roles", {}), theme.get("style", {})
    required = ("focus", "accent2", "border_normal")
    missing = [key for key in required if key not in roles]
    if missing:
        raise ValueError("theme contract is missing roles: " + ", ".join(missing))
    color = lambda key: "rgba(" + roles[key].lstrip("#") + "ff)"
    gaps = max(0, int(style.get("gaps", 8)))
    shadow_color = str(style.get("shadow_color", roles.get("shadow", "#000000"))).lstrip("#")
    shadow_alpha = max(0, min(255, round(float(style.get("shadow_opacity", .4)) * 255)))
    offset = style.get("shadow_offset", "0 0")
    if isinstance(offset, (int, float)):
        offset = f"0 {int(offset)}"
    lines = [
        "-- AUTO-GENERATED by lakota-hypr-theme; do not edit.",
        f"-- Contract theme: {theme.get('name', 'unknown')}; Hyprland: {'.'.join(map(str, version))}",
        "hl.config({",
        "    general = {",
        f"        border_size = {max(0, int(style.get('border_width', 2)))},",
        f"        gaps_in = {max(0, gaps // 2)},",
        f"        gaps_out = {gaps},",
        "        col = {",
        # hl.config's typed Lua bridge accepts a single colour here; native
        # .conf gradient strings are rejected as an invalid colour.
        f"            active_border = {lua_string(color('focus'))},",
        f"            inactive_border = {lua_string(color('border_normal'))},",
        "        },",
        "    },",
        "    group = {",
        "        groupbar = {",
        f"            border_active = {lua_string(color('accent2'))},",
        f"            border_locked_active = {lua_string(color('focus'))},",
        "        },",
        "    },",
        "    decoration = {",
        f"        rounding = {max(0, int(style.get('corner_radius', 0)))},",
        f"        active_opacity = {float(style.get('opacity', 1.0))},",
        f"        inactive_opacity = {float(style.get('opacity_inactive', 1.0))},",
        "        blur = {",
        f"            enabled = {str(boolean(style.get('blur_on'))).lower()},",
        f"            size = {max(1, int(style.get('blur_strength', 1)))},",
        "        },",
        "        shadow = {",
        f"            enabled = {str(boolean(style.get('shadow_on'), True)).lower()},",
        f"            range = {max(0, int(style.get('shadow_radius', 20)))},",
        f"            render_power = {max(1, min(4, int(style.get('shadow_render_power', 3))))},",
        f"            offset = {lua_string(str(offset))},",
        f"            color = {lua_string('rgba(' + shadow_color + format(shadow_alpha, '02x') + ')')},",
        "        },",
        "    },",
        "})",
    ]
    return "\n".join(lines) + "\n"


def generate(contract: Path = CONTRACT, output: Path = GENERATED) -> Path:
    theme = json.loads(contract.read_text(encoding="utf-8"))
    atomic_write(output, render(theme, installed_version()))
    return output


def backup(path: Path) -> Path:
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    destination = path.with_name(path.name + f".bak-lakota-{stamp}")
    if path.exists():
        shutil.copy2(path, destination)
    else:
        destination.write_text("", encoding="utf-8")
    return destination


def strip_block(content: str) -> str:
    pattern = re.compile(rf"\n?{re.escape(BEGIN)}.*?{re.escape(END)}\n?", re.S)
    return pattern.sub("\n", content).strip() + ("\n" if content.strip() else "")


def install() -> None:
    generate()
    current = ACTIVE_LUA.read_text(encoding="utf-8") if ACTIVE_LUA.exists() else ""
    if BEGIN not in current:
        saved = backup(ACTIVE_LUA)
        atomic_write(ACTIVE_LUA, current.rstrip() + ("\n\n" if current.strip() else "") + BLOCK + "\n")
        print(f"installed integration; backup: {saved}")
    else:
        print("integration already installed")
    reload_hyprland()


def disable() -> None:
    if not ACTIVE_LUA.exists() or BEGIN not in ACTIVE_LUA.read_text(encoding="utf-8"):
        print("integration already disabled")
        return
    saved = backup(ACTIVE_LUA)
    atomic_write(ACTIVE_LUA, strip_block(ACTIVE_LUA.read_text(encoding="utf-8")))
    print(f"disabled integration; backup: {saved}")
    reload_hyprland()


def reload_hyprland() -> None:
    proc = subprocess.run(["hyprctl", "reload"], text=True, capture_output=True, check=False)
    if proc.returncode:
        print("generated successfully; Hyprland IPC unavailable, reload deferred")
        return
    errors = subprocess.run(["hyprctl", "configerrors"], text=True, capture_output=True, check=False)
    if errors.stdout.strip():
        raise RuntimeError("Hyprland reported configuration errors after reload:\n" + errors.stdout)
    print("Hyprland reloaded without configuration errors")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("generate", "apply", "install", "disable", "status"))
    args = parser.parse_args()
    if args.action == "generate": print(generate())
    elif args.action == "apply": generate(); reload_hyprland()
    elif args.action == "install": install()
    elif args.action == "disable": disable()
    else:
        enabled = ACTIVE_LUA.exists() and BEGIN in ACTIVE_LUA.read_text(encoding="utf-8")
        print("enabled" if enabled else "disabled")


if __name__ == "__main__":
    main()
