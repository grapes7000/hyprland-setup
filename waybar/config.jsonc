{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,
  "modules-left":   ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "custom/window-tracker"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/vpn", "custom/sysstat", "pulseaudio", "network", "custom/notifications", "custom/running-apps", "tray"],

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/vpn.sh"
  },


  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 1",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 1"
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 2",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 2"
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 3",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 3"
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 4",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 4"
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 5",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 5"
  },
  "custom/ws6": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 6",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 6"
  },
  "custom/ws7": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 7",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 7"
  },
  "custom/ws8": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 8",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 8"
  },
  "custom/ws9": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 9",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 9"
  },
  "custom/ws10": {
    "exec": "~/.config/waybar/scripts/workspaces.sh 10",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "escape": false,
    "on-click": "~/.config/waybar/scripts/ws-click.sh 10"
  },

  "custom/window-tracker": {
    "exec": "~/.config/waybar/scripts/window-tracker.sh",
    "return-type": "text",
    "max-length": 60,
    "on-click": "hyprctl dispatch focuswindow ^0"
  },

  "custom/running-apps": {
    "exec": "~/.config/waybar/scripts/running-apps.sh",
    "return-type": "text",
    "interval": 3,
    "tooltip-format": "Running apps"
  },
  "clock": {
    "format": "  {:%a %d %b   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/sysstat": {
    "exec": "python3 ~/.config/waybar/scripts/sysstat.py",
    "return-type": "json",
    "interval": 4,
    "on-click": "command -v btop >/dev/null && kitty btop || true"
  },
  "custom/notifications": {
    "exec": "python3 ~/.config/waybar/scripts/notifications.py",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.config/bin/notification-center",
    "on-click-middle": "dunstctl history-pop",
    "on-click-right": "dunstctl set-paused toggle"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ipaddr}",
    "format-disconnected": "  off",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "tray": { "spacing": 10 }
}
