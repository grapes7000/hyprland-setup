{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,
  "modules-left":   ["hyprland/workspaces", "custom/window-tracker"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/vpn", "cpu", "memory", "pulseaudio", "network", "tray"],

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/vpn.sh"
  },


  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": { "default": "" , "active": "" , "urgent": "" }
  },

  "custom/window-tracker": {
    "exec": "~/.config/waybar/scripts/window-tracker.sh",
    "return-type": "text",
    "max-length": 60,
    "on-click": "hyprctl dispatch focuswindow ^0"
  },
  "clock": {
    "format": "  {:%a %d %b   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu":    { "format": "  {usage}%", "interval": 2 },
  "memory": { "format": "  {}%" },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ipaddr}",
    "format-disconnected": "  off",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "tray": { "spacing": 10 }
}
