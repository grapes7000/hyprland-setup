(defpoll system-data :interval "2s" "$EWW_CONFIG_DIR/scripts/system-stats.py")
(defpoll audio-data :interval "2s" "$EWW_CONFIG_DIR/scripts/panel-data.py audio")
(defpoll network-data :interval "5s" "$EWW_CONFIG_DIR/scripts/panel-data.py network")
(defpoll clock-data :interval "1s" "$EWW_CONFIG_DIR/scripts/panel-data.py clock")
(defpoll apps-data :interval "3s" "$EWW_CONFIG_DIR/scripts/panel-data.py apps")

(defwidget close-button [] (button :class "panel-button close-button" :onclick "waybar-panel close-all" "󰅖  Close"))
(defwidget resource-card [icon label percent detail warning critical]
  (box :class {"resource-card " + (critical ? "critical" : (warning ? "warning" : ""))} :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "resource-icon" :text icon)
      (label :class "resource-label" :text label)
      (label :class "resource-value" :hexpand true :halign "end" :text {percent + "%"}))
    (progress :class "resource-progress" :value {percent / 100})
    (label :class "resource-detail" :halign "start" :text detail)))
(defwidget system-monitor []
  (overlay
    (eventbox :onclick "waybar-panel close-all" (box :hexpand true :vexpand true))
    (box :halign "end" :valign "start" :width 510
      (box :class "system-panel" :orientation "v" :space-evenly false
    (label :class "panel-title" :halign "start" :text "󰻠  SYSTEM MONITOR")
    (box :class "resource-grid" :orientation "h" :space-evenly false
      (resource-card :icon "󰻠" :label "CPU" :percent {system-data.cpu.percent} :detail {"Load " + system-data.load} :warning {system-data.cpu.percent >= 75} :critical {system-data.cpu.percent >= 90})
      (resource-card :icon "󰘚" :label "MEMORY" :percent {system-data.memory.percent} :detail {system-data.memory.detail} :warning {system-data.memory.percent >= 75} :critical {system-data.memory.percent >= 90}))
    (box :class "resource-grid" :orientation "h" :space-evenly false
      (resource-card :icon "󰋊" :label "ROOT FILESYSTEM" :percent {system-data.disk.percent} :detail {system-data.disk.detail} :warning {system-data.disk.percent >= 85} :critical {system-data.disk.percent >= 95})
      (box :class "resource-card" :orientation "v" :space-evenly false
        (label :class "resource-label" :halign "start" :text "󰥔  UPTIME")
        (label :class "resource-value" :halign "start" :text {system-data.uptime})
        (label :class "resource-detail" :halign "start" :text {"Temperature " + (system-data.temperature.celsius < 0 ? "unavailable" : (system-data.temperature.celsius + "°C"))})))
    (box :class "process-section" :orientation "v" :space-evenly false
      (label :class "section-title" :halign "start" :text "TOP PROCESSES")
      (for process in {system-data.processes}
        (box :class "process-row" :orientation "h" :tooltip {"PID " + process.pid}
          (label :class "process-name" :halign "start" :hexpand true :limit-width 24 :text {process.name})
          (label :class "process-value" :text {process.cpu + "% CPU"})
          (label :class "process-value" :text {process.memory + "% MEM"}))))
    (box :class "panel-actions" :orientation "h" :space-evenly false
      (button :class "panel-button" :onclick "waybar-panel system btop" "󰍉  Open btop")
      (button :class "panel-button" :onclick "eww reload --config $EWW_CONFIG_DIR" "󰑐  Refresh")
      (close-button))))))
(defwidget audio-panel []
  (overlay
    (eventbox :onclick "waybar-panel close-all" (box :hexpand true :vexpand true))
    (box :halign "end" :valign "start" :width 510
      (box :class "panel" :orientation "v" :space-evenly false
    (label :class "panel-title" :halign "start" :text "󰕾  AUDIO & MEDIA")
    (label :class "panel-line" :halign "start" :text {audio-data.volume + "%  " + audio-data.muted})
    (label :class "panel-line" :halign "start" :text {audio-data.device})
    (label :class "panel-line" :halign "start" :text {audio-data.title + "  " + audio-data.artist})
    (box :class "panel-actions" (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh audio down" "󰍮") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh audio mute" "󰖁") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh audio up" "󰍬") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh audio play-pause" "󰐊") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh audio pavucontrol" "󰖂"))
    (close-button)))))
(defwidget network-panel []
  (overlay
    (eventbox :onclick "waybar-panel close-all" (box :hexpand true :vexpand true))
    (box :halign "end" :valign "start" :width 510
      (box :class "panel" :orientation "v" :space-evenly false
    (label :class "panel-title" :halign "start" :text "󰤨  NETWORK & VPN")
    (label :class "panel-line" :halign "start" :text {network-data.state + "  " + network-data.interface})
    (label :class "panel-line" :halign "start" :text {network-data.ssid + "  " + network-data.signal + "%  " + network-data.security})
    (label :class "panel-line" :halign "start" :text {network-data.ipv4 + "  gateway " + network-data.gateway})
    (label :class "panel-line" :halign "start" :text {"󰩟 " + network-data.down + "   󰩠 " + network-data.up + "   󰔟 " + network-data.ping})
    (label :class "panel-line" :halign "start" :text {"Mullvad: " + network-data.mullvad})
    (label :class "panel-line" :halign "start" :text {"Tailscale: " + network-data.tailscale})
    (box :class "panel-actions" (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh network copy-local" "Copy local IP") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh network copy-tailscale" "Copy Tailscale") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh network settings" "Settings"))
    (close-button)))))
(defwidget clock-panel []
  (overlay
    (eventbox :onclick "waybar-panel close-all" (box :hexpand true :vexpand true))
    (box :halign "center" :valign "start" :width 480
      (box :class "panel" :orientation "v" :space-evenly false
    (label :class "clock-time" :text {clock-data.time})
    (label :class "panel-line" :text {clock-data.date})
    (label :class "panel-line" :text {clock-data.timezone})
    (label :class "calendar" :halign "start" :text {clock-data.calendar})
    (box :class "panel-actions" (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh clock copy-time" "Copy time") (button :class "panel-button" :onclick "$EWW_CONFIG_DIR/scripts/panel-action.sh clock copy-date" "Copy date"))
    (close-button)))))
(defwidget apps-panel []
  (overlay
    (eventbox :onclick "waybar-panel close-all" (box :hexpand true :vexpand true))
    (box :halign "start" :valign "start" :width 560
      (box :class "panel" :orientation "v" :space-evenly false
    (label :class "panel-title" :halign "start" :text "󰣆  RUNNING APPLICATIONS")
    (for app in {apps-data.apps} (button :class {app.active ? "app-row active" : "app-row"} :onclick {"hyprctl dispatch focuswindow address:" + app.address} {app.name + "  " + app.title + "  [" + app.workspace + "]"}))
    (close-button)))))

(defwindow system-monitor :monitor 0 :stacking "overlay" :exclusive false :focusable true :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top right") (system-monitor))
(defwindow audio-panel :monitor 0 :stacking "overlay" :exclusive false :focusable true :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top right") (audio-panel))
(defwindow network-panel :monitor 0 :stacking "overlay" :exclusive false :focusable true :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top right") (network-panel))
(defwindow clock-panel :monitor 0 :stacking "overlay" :exclusive false :focusable true :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top center") (clock-panel))
(defwindow apps-panel :monitor 0 :stacking "overlay" :exclusive false :focusable true :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top left") (apps-panel))
